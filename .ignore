# Search-tool ignore rules (ripgrep / editor search). Higher priority than
# .gitignore, and applies to tools that pass --hidden. Keeps whole-workspace
# searches off the multi-GB directories so they don't hit the 20s timeout.

.git/
node_modules/
.pnpm-store/
dist/
dist-ssr/
release/
**/target/
examples/
docs/*
!docs/codemap/
!docs/codemap/*.md
.cursor/*
!.cursor/rules/
.cursor/rules/*
!.cursor/rules/codemap.mdc
.codemap-fixture/
src-tauri\target